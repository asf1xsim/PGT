{
  "name": "chat-service",
  "version": "1.0.0",
  "description": "Real-time chat service for PlayGamesTogether",
  "main": "dist/app.js",
  "scripts": {
    "start": "node dist/app.js",
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "kill-port": "powershell -Command \"$p = Get-NetTCPConnection -LocalPort 3003 -ErrorAction SilentlyContinue | Select -ExpandProperty OwningProcess -Unique; if($p){Stop-Process -Id $p -Force}\"",
    "restart": "npm run kill-port && npm start",
    "build": "tsc",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "mongodb": "^6.3.0",
    "reflect-metadata": "^0.2.1",
    "socket.io": "^4.6.1",
    "socket.io-client": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.5",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^6.3.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
